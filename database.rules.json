{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.length >= 4 && $code.length <= 8"
      }
    },
    "lobby": {
      ".read": true,
      "$code": {
        ".write": true,
        ".validate": "$code.length >= 4 && $code.length <= 8"
      }
    }
  }
}
